# Supabase browser-safe project values
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only values required for Meta Lead Ads webhook delivery
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
META_VERIFY_TOKEN=replace-with-a-long-random-private-value
META_APP_SECRET=server-only-meta-app-secret
META_ACCESS_TOKEN=server-only-meta-page-access-token
META_GRAPH_API_VERSION=v26.0

# Optional CRM help assistant
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
